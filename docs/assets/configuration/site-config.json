{
  "site": "example-site",
  "config": {
    "profile": {
      "fields": {
        "title": 3,
        "topics": 4
      },
      "text_fields": [
        "title"
      ],
      "id_field": "nid"
    },
    "privacy": {
      "consent_default": "granted",
      "respect_gpc": true,
      "cookies": false
    },
    "analytics": {
      "events": false
    },
    "profilers": {
      "page_id": {
        "sources": [
          {
            "type": "meta",
            "attribute_name": "nid"
          }
        ],
        "processors": [
          {
            "type": "temp",
            "storage_key": "nid"
          }
        ]
      },
      "page_title": {
        "sources": [
          {
            "type": "meta",
            "attribute_name": "title"
          }
        ],
        "processors": [
          {
            "type": "temp",
            "storage_key": "title"
          }
        ]
      },
      "page_topics": {
        "sources": [
          {
            "type": "meta",
            "attribute_name": "topic"
          }
        ],
        "processors": [
          {
            "type": "temp_list",
            "storage_key": "topics"
          },
          {
            "type": "dimension",
            "storage_key": "topics"
          }
        ],
        "destinations": [
          {
            "type": "top",
            "dimension": "topics",
            "target_key": "preferred_topic",
            "target_location": {
              "localstorage": true,
              "cookie": false
            }
          }
        ]
      },
      "learn": {
        "processors": [
          {
            "type": "profile",
            "storage_key": "interests",
            "decay": 86400
          }
        ]
      }
    }
  }
}
