{
  "name": "convivial-personalisation",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Clientside personalisation engine for building profiles and ranking content.",
  "main": "dist/bundle.js",
  "scripts": {
    "start": "npm run docs:preview",
    "docs:preview": "node scripts/preview-docs.mjs",
    "dev": "vite --host 127.0.0.1 --port 8080 --strictPort",
    "build": "vite build",
    "check": "node scripts/check-docs.cjs",
    "test": "vitest run && node --test scripts/docs-preview/preview.test.mjs"
  },
  "engines": { "node": ">=22.12.0" },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "marked": "^17.0.6",
    "prismjs": "^1.30.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
